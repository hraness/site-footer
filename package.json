{
  "name": "@hraness/site-footer",
  "version": "0.5.0",
  "description": "The canonical Hraness network footer for React and static websites.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./compiler-foundation.css",
    "./dist/stylex.css"
  ],
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/site-footer.git"
  },
  "homepage": "https://github.com/hraness/site-footer#readme",
  "bugs": {
    "url": "https://github.com/hraness/site-footer/issues"
  },
  "keywords": [
    "footer",
    "hraness",
    "react",
    "static-html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./styles.css",
    "./compiler-foundation.css": "./compiler-foundation.css",
    "./stylex.css": "./dist/stylex.css",
    "./stylex-manifest.json": "./dist/stylex-manifest.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles.css",
  "files": [
    "dist",
    "styles.css",
    "compiler-foundation.css",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "test": "bun test --preload ./scripts/register-stylex-test-transform.ts ./tests",
    "check:stylex-artifacts": "bun run ./scripts/check-stylex-artifacts.ts",
    "check:stylex-determinism": "bun run ./scripts/check-stylex-determinism.ts",
    "verify:browser": "bun run ./.agents/skills/verify-site-footer/scripts/verify.ts run",
    "verify:browser:doctor": "bun run ./.agents/skills/verify-site-footer/scripts/verify.ts doctor",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check": "bun run ./scripts/check.ts",
    "prepack": "bun run check"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@hraness/direct": "0.7.18",
    "@hraness/ui": "github:hraness/ui#v0.5.3",
    "@hugeicons/core-free-icons": "4.2.2",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.1.9",
    "agent-browser": "0.32.3",
    "linkedom": "0.18.12",
    "lightningcss": "1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
