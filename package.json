{
  "name": "@hraness/site-footer",
  "version": "0.3.0",
  "description": "The canonical Hraness network footer for React and static websites.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/site-footer.git"
  },
  "homepage": "https://github.com/hraness/site-footer#readme",
  "bugs": {
    "url": "https://github.com/hraness/site-footer/issues"
  },
  "keywords": [
    "footer",
    "hraness",
    "react",
    "static-html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./styles.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./styles.css",
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "test": "bun test ./tests",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check": "bun run ./scripts/check.ts",
    "prepack": "bun run check"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "4.2.2",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.1.9",
    "linkedom": "0.18.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
